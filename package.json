{
	"name": "hstl.pro",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"postbuild": "next-sitemap",
		"lint:md": "markdownlint --config .markdownlint.json \"content/**/*.md\"",
		"check-links": "markdown-link-check -c .markdown-link-check.json \"content/**/*.md\"",
		"lint:prose": "vale content || true",
		"lint:all": "bun run lint:md && bun run check-links && bun run lint:prose",
		"test:mdx": "node scripts/test-mdx.js",
		"seo:score": "node scripts/seo-score.js",
		"setup:dev": "echo \"Run the commands in DEV_DOCS.md to install dev tools with bun\""
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@vercel/analytics": "^2.0.1",
		"@vercel/og": "^1.0.2",
		"@vercel/speed-insights": "^2.0.0",
		"clsx": "^2.1.1",
		"framer-motion": "^13.1.1",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.37.0",
		"next": "16.3.3",
		"next-mdx-remote": "^6.0.0",
		"next-sitemap": "^4.2.3",
		"next-themes": "^0.4.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prism-react-renderer": "^2.4.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-github-calendar": "^5.0.9",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"alex": "^11.0.1",
		"eslint": "10.9.1",
		"eslint-config-next": "16.3.3",
		"markdown-link-check": "^3.15.0",
		"markdownlint-cli": "^0.49.1",
		"postcss": "^8.5.26",
		"remark-cli": "^12.0.1",
		"remark-lint": "^10.0.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "7.0.2"
	}
